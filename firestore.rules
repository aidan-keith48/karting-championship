rules_version = '2';

// Apex Karting League — Firestore security rules.
// Public read (the site itself isn't gated), write restricted to a
// hardcoded email allowlist reached via Google Sign-In. This list is the
// actual security boundary — assets/js/firebase-config.js keeps a client-side
// copy (EDITOR_ALLOWLIST) purely to drive the Editor's UI (hide/disable
// forms), never trust that copy alone. Keep the two in sync by hand.
service cloud.firestore {
  match /databases/{database}/documents {
    // .lower() on both sides — Gmail addresses are case-insensitive, and
    // relying on Google always reporting the same casing back in the auth
    // token isn't something to bet an allowlist on.
    function isAllowlisted() {
      return request.auth != null && request.auth.token.email.lower() in [
        'aidannaidoo2801@gmail.com',
        'mzshaik1@gmail.com',
        'daiyaanmanique1@gmail.com',
        'mohamadroshan786@gmail.com',
        'moimthapelo24@gmail.com'
      ];
    }

    match /{collection}/{id} {
      allow read: if true;
      allow write: if isAllowlisted();
    }
  }
}
